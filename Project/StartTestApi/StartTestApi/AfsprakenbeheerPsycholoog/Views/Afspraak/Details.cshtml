@using AfsprakenbeheerPsycholoog.Data.Entities
@model AfsprakenbeheerPsycholoog.Models.ViewModels.Afspraak.AfspraakDetailViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Afspraak details</h1>

<div class="card mb-4">
    <div class="card-header" style="border-left: 5px solid @Model.Kleurcode;">
        <h5 class="mb-0">
            <span style="display:inline-block; width:14px; height:14px;
                         background-color:@Model.Kleurcode; border-radius:50%;
                         margin-right:8px;"></span>
            @Model.AfspraakTypeNaam
            <span class="badge @Model.StatusLabel">@Model.Status</span>
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Linkerkolom: Afspraakinfo -->
            <div class="col-md-6">
                <h6 class="text-muted">📅 Afspraak</h6>
                <dl class="row">
                    <dt class="col-sm-5">Datum</dt>
                    <dd class="col-sm-7">@Model.Starttijd.ToString("dddd d MMMM yyyy")</dd>
                    <dt class="col-sm-5">Van</dt>
                    <dd class="col-sm-7">@Model.Starttijd.ToString("HH:mm")</dd>
                    <dt class="col-sm-5">Tot</dt>
                    <dd class="col-sm-7">@Model.Eindtijd.ToString("HH:mm")</dd>
                    <dt class="col-sm-5">Duur</dt>
                    <dd class="col-sm-7">@((Model.Eindtijd - Model.Starttijd).TotalMinutes) minuten</dd>
                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7">@Model.Status</dd>
                </dl>
            </div>
            <!-- Rechterkolom: Patiëntinfo -->
            <div class="col-md-6">
                <h6 class="text-muted">👤 Patiënt</h6>
                <dl class="row">
                    <dt class="col-sm-5">Naam</dt>
                    <dd class="col-sm-7">@Model.PatientVolledigeNaam</dd>
                    <dt class="col-sm-5">E-mail</dt>
                    <dd class="col-sm-7">
                        <a href="mailto:@Model.PatientEmail">@Model.PatientEmail</a>
                    </dd>
                    <dt class="col-sm-5">Telefoon</dt>
                    <dd class="col-sm-7">
                        <a href="tel:@Model.PatientTelefoon">@Model.PatientTelefoon</a>
                    </dd>
                </dl>
            </div>
        </div>
        <!-- Opmerkingen -->
        @if (!string.IsNullOrWhiteSpace(Model.Opmerkingen))
        {
            <hr />
            <h6 class="text-muted">📝 Opmerkingen</h6>
            <p>@Model.Opmerkingen</p>
        }
    </div>
</div>
<!-- Acties -->
<a asp-action="Edit" asp-route-id="@Model.Id"
   class="btn btn-outline-secondary">Bewerken</a>
<a asp-action="Dagplanning"
   asp-route-datum="@Model.Starttijd.ToString("yyyy-MM-dd")"
   class="btn btn-outline-primary">Naar dagplanning</a>
<a asp-action="Index" class="btn btn-secondary">Terug naar lijst</a>
