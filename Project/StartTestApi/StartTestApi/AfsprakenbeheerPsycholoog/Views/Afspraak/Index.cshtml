@model IEnumerable<AfsprakenbeheerPsycholoog.Models.ViewModels.Afspraak.AfspraakListViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Alle afspraken</h1>

<p>
    <a asp-action="Create" class="btn btn-primary mb-3">+ Nieuwe afspraak</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PatientNaam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AfspraakTypeNaam)
            </th>
            <th>
                Datum
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Starttijd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Eindtijd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PatientNaam</td>
                <td>
                    <span style="display:inline-block; width:12px; height:12px;
                                         background-color:@item.Kleurcode; border-radius:50%;
                                         margin-right:6px;"></span>
                    @item.AfspraakTypeNaam
                </td>
                <td>@item.Starttijd.ToString("dd/MM/yyyy")</td>
                <td>@item.Starttijd.ToString("HH:mm")</td>
                <td>@item.Eindtijd.ToString("HH:mm")</td>
                <td><span class="badge @item.StatusLabel">@item.Status</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary">Bewerken</a>

                    <form asp-action="Delete" asp-route-id="@item.Id"
                          method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Weet je het zeker?')">
                            Verwijderen
                        </button>
                    </form>

                    @if (item.ReeksId.HasValue)
                    {
                        <form asp-action="DeleteReeks" asp-route-reeksId="@item.ReeksId"
                              method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Hele reeks verwijderen?')">
                                Verwijder reeks
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>