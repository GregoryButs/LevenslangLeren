@using AfsprakenbeheerPsycholoog.Models.ViewModels.Afspraak
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model CreateAfspraakViewModel


<h1>Nieuwe afspraak</h1>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="PatientId" class="form-label"></label>
        <select asp-for="PatientId" asp-items="Model.PatientenLijst" class="form-select">
            <option value="">-- Geen patiënt (blokkering/pauze) --</option>
        </select>
        <span asp-validation-for="PatientId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TypeId" class="form-label"></label>
        <select asp-for="TypeId" asp-items="Model.TypenLijst" class="form-select">
            <option value="">-- Kies een type --</option>
        </select>
        <span asp-validation-for="TypeId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Starttijd" class="form-label"></label>
        <input asp-for="Starttijd" class="form-control" type="datetime-local" />
        <span asp-validation-for="Starttijd" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Opmerkingen" class="form-label"></label>
        <textarea asp-for="Opmerkingen" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Herhaling" class="form-label"></label>
        <select asp-for="Herhaling" class="form-select">
            <option value="Geen">Niet herhalen</option>
            <option value="Dagelijks">Dagelijks</option>
            <option value="Wekelijks">Wekelijks</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="HerhaalTot" class="form-label"></label>
        <input asp-for="HerhaalTot" class="form-control" type="date" />
        <span asp-validation-for="HerhaalTot" class="text-danger"></span>
    </div>
    <p class="text-muted">De eindtijd wordt automatisch berekend op basis van het afspraaktype.</p>
    <button type="submit" class="btn btn-success">Opslaan</button>
    <a asp-action="Index" class="btn btn-secondary">Annuleren</a>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}