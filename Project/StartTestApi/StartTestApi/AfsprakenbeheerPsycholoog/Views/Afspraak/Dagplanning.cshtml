@using AfsprakenbeheerPsycholoog.Models.ViewModels.Planning
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model DagOverzichtViewModel

<h1>📅 Dagplanning — @Model.Datum.ToString("dddd d MMMM yyyy")</h1>

<div class="mb-3">
    <a asp-action="Dagplanning" asp-route-datum="@Model.VorigeDag.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">← Vorige dag</a>
    <a asp-action="Dagplanning" asp-route-datum="@DateTime.Today.ToString("yyyy-MM-dd")"
       class="btn btn-outline-primary">Vandaag</a>
    <a asp-action="Dagplanning" asp-route-datum="@Model.VolgendeDag.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">Volgende dag →</a>
</div>

@if (!Model.IsWerkdag)
{
    <div class="alert alert-warning">Dit is een weekend. Geen werkdag.</div>
}
else
{
    <table class="table">
        @foreach (var slot in Model.Tijdsloten)
        {
            <tr class="@(slot.IsBezet ? "table-warning" : "table-success")">
                <td style="width:140px">
                    <strong>@slot.StartFormatted — @slot.EindFormatted</strong>
                </td>
                <td>
                    @if (slot.IsBezet && slot.Afspraak != null)
                    {
            <span style="display:inline-block; width:12px; height:12px;
                                     background-color:@slot.Afspraak.Kleurcode;
                                     border-radius:50%; margin-right:6px;"></span>
            <strong>@slot.Afspraak.PatientNaam</strong>
                        @slot.Afspraak.AfspraakTypeNaam
                        <span class="badge @slot.Afspraak.StatusLabel ms-2">@slot.Afspraak.Status</span>
                        }
                        else
            {
                <a asp-action="Create"
                   asp-route-starttijd="@((Model.Datum.Date + slot.Starttijd).ToString("yyyy-MM-ddTHH:mm"))"
                   class="btn btn-sm btn-outline-success">+ Inplannen</a>
            }
        </td>
    </tr>
        }
</table>
}
