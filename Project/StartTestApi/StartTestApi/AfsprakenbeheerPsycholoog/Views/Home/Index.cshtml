@model AfsprakenbeheerPsycholoog.Models.ViewModels.Planning.WeekOverzichtViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-5">
    <h1 class="display-4">Welkom bij Groepspraktijk Voorde - Dr. Inge Debast</h1>
    <p>Uw partner in mentaal welzijn en professionele begeleiding.</p>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    @if (Model != null && Model.Dagen.Any())
    {
        <div class="container mt-4">
            <partial name="_WeekKalender" model="Model" />
        </div>
    }
}
else
{
    <div class="alert alert-info text-center">
        Log in om uw afspraken en agenda in te zien.
    </div>
}
