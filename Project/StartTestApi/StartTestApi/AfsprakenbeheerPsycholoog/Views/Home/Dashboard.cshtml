@using AfsprakenbeheerPsycholoog.Models.ViewModels.Dashboard
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model DashboardViewModel

<h1>Ingelogd als: @Model.PsycholoogNaam</h1>
<p class="text-muted">@Model.Vandaag.ToString("dddd d MMMM yyyy")</p>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary">
            <div class="card-body text-center">
                <h2>@Model.AantalAfsprakenVandaag</h2>
                <p>Komende afspraken vandaag</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info">
            <div class="card-body text-center">
                <h2>@Model.AantalAfsprakenDezeWeek</h2>
                <p>Komende afspraken deze week</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success">
            <div class="card-body text-center">
                <h2>@Model.AantalPatienten</h2>
                <p>Patiënten</p>
            </div>
        </div>
    </div>
</div>

@if (Model.VolgendeAfspraak != null)
{
    <div class="alert alert-info">
        <strong>Volgende afspraak:</strong>
        @Model.VolgendeAfspraak.Starttijd.ToString("dd/MM HH:mm")
        — @Model.VolgendeAfspraak.PatientNaam
        (@Model.VolgendeAfspraak.AfspraakTypeNaam)
    </div>
}

<h3>Vandaag</h3>
@if (!Model.AfsprakenVandaag.Any())
{
    <p class="text-muted">Geen afspraken vandaag.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr><th>Tijd</th><th>Patiënt</th><th>Type</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model.AfsprakenVandaag)
            {
                <tr>
                    <td>@a.Starttijd.ToString("HH:mm") — @a.Eindtijd.ToString("HH:mm")</td>
                    <td>@a.PatientNaam</td>
                    <td>
                        <span style="display:inline-block; width:12px; height:12px;
                                             background-color:@a.Kleurcode; border-radius:50%;
                                             margin-right:4px;"></span>
                        @a.AfspraakTypeNaam
                    </td>
                    <td>
                        <a asp-controller="Afspraak" asp-action="Details" asp-route-id="@a.Id"
                           class="btn btn-sm btn-outline-info">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-5">
    <partial name="_WeekKalender" model="Model.WeekOverzicht" />
</div>

<a asp-controller="Afspraak" asp-action="Dagplanning" class="btn btn-primary mt-4">
    Naar dagplanning →
</a>

