@using AfsprakenbeheerPsycholoog.Models.ViewModels.PatientPortaal
@using AfsprakenbeheerPsycholoog.Models.ViewModels.Planning
@model PatientBoekAfspraakViewModel

@{
    var overzicht = ViewBag.DagOverzicht as DagOverzichtViewModel;
}

@if (overzicht == null)
{
    <div class="alert alert-danger">Dagoverzicht kon niet geladen worden.</div>
    return;
}

<h1>📅 Afspraak boeken — @overzicht.Datum.ToString("dddd d MMMM yyyy")</h1>

<div class="mb-3">
    @if (overzicht.KanNaarVorigeWerkdag)
    {
        <a asp-action="Boeken" asp-route-datum="@overzicht.VorigeWerkdag.ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary">← Vorige dag</a>
    }
    else
    {
        <button type="button" class="btn btn-outline-secondary" disabled>← Vorige dag</button>
    }

    <a asp-action="Boeken" asp-route-datum="@overzicht.VolgendeWerkdag.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">Volgende dag →</a>
</div>

<form asp-action="Boeken" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <div class="col-md-6">
            <h5>Tijdsloten (1 uur)</h5>

            <div class="d-grid gap-2">
                @{
                    var vrijeIndex = 0;
                }

                @foreach (var slot in overzicht.Tijdsloten)
                {
                    if (!slot.IsBezet)
                    {
                        var inputId = $"slot_{vrijeIndex}";
                        var value = (overzicht.Datum.Date + slot.Starttijd).ToString("yyyy-MM-ddTHH:mm:ss");
                        vrijeIndex++;

                        <input class="btn-check"
                               type="radio"
                               asp-for="GekozeTijdslot"
                               id="@inputId"
                               value="@value"
                               autocomplete="off"
                               required />
                        <label class="btn btn-outline-success text-start" for="@inputId">
                            🟢 @slot.StartFormatted — @slot.EindFormatted
                        </label>
                    }
                    else
                    {
                        <span class="btn btn-outline-secondary text-start disabled">
                            🔴 @slot.StartFormatted — @slot.EindFormatted (bezet)
                        </span>
                    }
                }
            </div>

            <span asp-validation-for="GekozeTijdslot" class="text-danger d-block mt-2"></span>
        </div>

        <div class="col-md-6">
            <h5>Jouw boeking</h5>

            <div class="mb-3">
                <label asp-for="Opmerkingen" class="form-label"></label>
                <textarea asp-for="Opmerkingen" class="form-control" rows="3"></textarea>
            </div>

            <button type="submit" class="btn btn-success">
                Afspraak boeken
            </button>
            <a asp-action="MijnAfspraken" class="btn btn-secondary">Annuleren</a>
        </div>
    </div>
</form>
