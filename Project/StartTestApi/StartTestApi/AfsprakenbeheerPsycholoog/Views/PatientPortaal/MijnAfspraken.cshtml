@using AfsprakenbeheerPsycholoog.Data.Entities
@model IEnumerable<AfsprakenbeheerPsycholoog.Models.ViewModels.Afspraak.AfspraakListViewModel>

@{
    ViewData["Title"] = "MijnAfspraken";
}

<h1>📋 Mijn afspraken</h1>

<a asp-action="Boeken" class="btn btn-primary mb-3">📅 Nieuwe afspraak boeken</a>

@if (!Model.Any())
{
    <div class="alert alert-info">Je hebt nog geen afspraken.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.AfspraakTypeNaam)
                </th>
                <th>
                    Datum
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Starttijd)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Eindtijd)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <span style="display:inline-block; width:12px; height:12px;
                                             background-color:@item.Kleurcode; border-radius:50%;
                                             margin-right:6px;"></span>
                        @item.AfspraakTypeNaam
                    </td>
                    <td>@item.Starttijd.ToString("dd/MM/yyyy")</td>
                    <td>@item.Starttijd.ToString("HH:mm")</td>
                    <td>@item.Eindtijd.ToString("HH:mm")</td>
                    <td><span class="badge @item.StatusLabel">@item.Status</span></td>
                    <td>
                        @if (item.Status == AfspraakStatus.Gepland && item.Starttijd > DateTime.Now)
                        {
                            <form asp-action="Annuleren" asp-route-id="@item.Id"
                                  method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Wil je deze afspraak annuleren?')">
                                    Annuleren
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}