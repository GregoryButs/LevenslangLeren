@model IEnumerable<AfsprakenbeheerPsycholoog.Models.ViewModels.Patient.PatientListViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>👤 Patiënten</h1>

<a asp-action="Create" class="btn btn-primary mb-3">+ Nieuwe patiënt</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.VolledigeNaam)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefoonnummer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DossierNummer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AantalAfspraken)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsGekoppeld)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">
                        @item.VolledigeNaam
                    </a>
                </td>
                <td>@item.Email</td>
                <td>@item.Telefoonnummer</td>
                <td>@(item.DossierNummer ?? "—")</td>
                <td><span class="badge bg-info">@item.AantalAfspraken</span></td>
                <td>
                    @if (item.IsGekoppeld)
                    {
                        <span class="badge bg-success">Gekoppeld</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Niet gekoppeld</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary">Bewerken</a>
                    <form asp-action="Delete" asp-route-id="@item.Id"
                          method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Weet je het zeker? Alle afspraken worden ook verwijderd.')">
                            Verwijderen
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
