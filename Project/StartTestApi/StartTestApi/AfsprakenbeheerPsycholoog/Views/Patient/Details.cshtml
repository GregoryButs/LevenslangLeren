@model AfsprakenbeheerPsycholoog.Models.ViewModels.Patient.PatientDetailViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Patiëntgegevens</h1>

<div>
    <h4>@Model.VolledigeNaam</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Geboortedatum)
        </dt>
        <dd class="col-sm-10">
            @Model.Geboortedatum.ToString("dd/MM/yyyy")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Voornaam)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Voornaam)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Achternaam)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Achternaam)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Telefoonnummer)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Telefoonnummer)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DossierNummer)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DossierNummer)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsGekoppeld)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsGekoppeld)
        </dd>
        <dd class="col-sm-7">
            @if (Model.IsGekoppeld)
            {
                <span class="badge bg-success">Ja</span>
                <form asp-action="Ontkoppel" asp-route-patientId="@Model.Id"
                      method="post" style="display:inline;" class="ms-2">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Ontkoppelen</button>
                </form>
            }
            else
            {
                <span class="badge bg-secondary">Nee</span>
                <form asp-action="Koppel" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="patientId" value="@Model.Id" />
                    <div class="input-group input-group-sm" style="max-width:350px;">
                        <input type="email" name="email" class="form-control"
                               placeholder="E-mailadres van account" required />
                        <button type="submit" class="btn btn-outline-primary">Koppelen</button>
                    </div>
                </form>
            }
        </dd>
    </dl>
</div>
<h3 class="mt-4">Afspraken</h3>
@if (!Model.Afspraken.Any())
{
    <p class="text-muted">Geen afspraken gevonden.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr><th>Datum</th><th>Tijd</th><th>Type</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Afspraken)
            {
                <tr>
                    <td>@a.Starttijd.ToString("dd/MM/yyyy")</td>
                    <td>@a.Starttijd.ToString("HH:mm") — @a.Eindtijd.ToString("HH:mm")</td>
                    <td>
                        <span style="display:inline-block; width:10px; height:10px;
                                                     background-color:@a.Kleurcode; border-radius:50%;
                                                     margin-right:4px;"></span>
                        @a.AfspraakTypeNaam
                    </td>
                    <td><span class="badge @a.StatusLabel">@a.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Bewerken</a>
<a asp-action="Index" class="btn btn-secondary">Terug</a>
