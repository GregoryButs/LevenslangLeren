@model IEnumerable<AfsprakenbeheerPsycholoog.Models.ViewModels.Patient.PatientListViewModel>

@{
    ViewData["Title"] = "Archief";
}

<h1>🗂️ Inactieve patiënten</h1>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Terug naar actieve patiënten</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Geen inactieve patiënten gevonden.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Naam</th>
                <th>E-mail</th>
                <th>Telefoon</th>
                <th>Dossiernummer</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.VolledigeNaam</td>
                <td>@item.Email</td>
                <td>@item.Telefoonnummer</td>
                <td>@(item.DossierNummer ?? "—")</td>
                <td>
                    <form asp-action="Heractiveer" asp-route-id="@item.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success">Heractiveer</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}