<div class="container mt-5">
    <div class="row">
        <!-- Hoofdmenu sectie -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">@Model.Menu.Naam</h1>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        @foreach (var gerecht in Model.Menu.Gerechten)
                        {
                            @if (gerecht.IsVeggie)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 fst-italic">
                                    <span>
                                        @gerecht.Naam<span class="badge bg-success ms-2">vegetarisch</span>
                                    </span>
                                    <span class="fw-bold text-primary">@gerecht.Prijs.ToString("C")</span>
                                </li>
                            }
                            else
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <span> @gerecht.Naam</span>
                                    <span class="fw-bold text-primary">@gerecht.Prijs.ToString("C")</span>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Sidebar met alle menu's -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm sticky-top" style="top: 20px;">
                <div class="card-header bg-secondary text-white">
                    <h3 class="h5 mb-0">
                        <i class="bi bi-list-ul me-2"></i>Alle Menu's
                    </h3>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var menu in Model.AllMenus)
                        {
                            <li class="list-group-item list-group-item-action @(menu.Id == Model.Menu.Id ? "active" : "")">
                                <a asp-controller="Menu" asp-action="Index" asp-route-id="@menu.Id"
                                   class="text-decoration-none @(menu.Id == Model.Menu.Id ? "text-white" : "text-dark")">
                                    <i class="bi bi-arrow-right-circle me-2"></i>@menu.Naam
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">