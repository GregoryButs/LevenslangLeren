@using CommeChesSwa.ViewModel
@using CommeChesSwa.Models
@model CommeChesSwa.ViewModel.GastViewModel

@{
    ViewData["Title"] = "Reservatie";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h1 class="h3 mb-0">
                        <i class="bi bi-calendar-check me-2"></i>Reservatieformulier
                    </h1>
                </div>
                <div class="card-body p-4">
                    <p class="lead mb-4">Reserveer je plek bij Comme Chez Swa</p>

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="All" class="alert-danger" role="alert"></div>

                        <!-- Persoonlijke Gegevens -->
                        <div class="mb-4">
                            <h5 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-person-fill me-2"></i>Persoonlijke Gegevens
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FirstName" class="form-label fw-bold"></label>
                                    <input asp-for="FirstName" class="form-control form-control-lg" placeholder="Voornaam" />
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="form-label fw-bold"></label>
                                    <input asp-for="LastName" class="form-control form-control-lg" placeholder="Achternaam" />
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label fw-bold"></label>
                                    <input asp-for="Email" class="form-control form-control-lg" placeholder="voorbeeld@email.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmEmail" class="form-label fw-bold"></label>
                                    <input asp-for="ConfirmEmail" class="form-control form-control-lg" placeholder="Bevestig email" />
                                    <span asp-validation-for="ConfirmEmail" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Reservatie Details -->
                        <div class="mb-4">
                            <h5 class="border-bottom pb-2 mb-3">
                                <i class="bi bi-calendar2-week me-2"></i>Reservatie Details
                            </h5>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ReservationDate" class="form-label fw-bold"></label>
                                    <input asp-for="ReservationDate" class="form-control form-control-lg" type="date" />
                                    <span asp-validation-for="ReservationDate" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="NumberOfGuests" class="form-label fw-bold"></label>
                                    <input asp-for="NumberOfGuests" class="form-control form-control-lg" type="number" min="1" placeholder="Aantal personen" />
                                    <span asp-validation-for="NumberOfGuests" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Time" class="form-label fw-bold d-block mb-3"></label>
                                <div class="btn-group w-100" role="group" aria-label="Tijd selectie">
                                    <input type="radio" class="btn-check" asp-for="Time" value="@Time.Ochtend" id="timeOchtend" />
                                    <label class="btn btn-outline-primary btn-lg" for="timeOchtend">
                                        <i class="bi bi-sunrise me-2"></i>@Time.Ochtend (8u30 - 11u)
                                    </label>

                                    <input type="radio" class="btn-check" asp-for="Time" value="@Time.Middag" id="timeMiddag" />
                                    <label class="btn btn-outline-primary btn-lg" for="timeMiddag">
                                        <i class="bi bi-sun me-2"></i>@Time.Middag (11u - 14u)
                                    </label>

                                    <input type="radio" class="btn-check" asp-for="Time" value="@Time.Avond" id="timeAvond" />
                                    <label class="btn btn-outline-primary btn-lg" for="timeAvond">
                                        <i class="bi bi-moon-stars me-2"></i>@Time.Avond (17u - 20u)
                                    </label>
                                </div>
                                <span asp-validation-for="Time" class="text-danger small d-block mt-2"></span>
                            </div>
                        </div>

                        <!-- Voorwaarden -->
                        <div class="mb-4">
                            <div class="p-3 bg-light rounded">
                                <div class="form-check d-flex align-items-center">
                                    <input type="checkbox" asp-for="AcceptTerms" class="form-check-input me-2" id="acceptTerms" style="width: 1.5rem; height: 1.5rem;" />
                                    <label asp-for="AcceptTerms" class="form-check-label" for="acceptTerms"></label>
                                </div>
                                <span asp-validation-for="AcceptTerms" class="text-danger small d-block mt-2 ms-5"></span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg py-3">
                                <i class="bi bi-check-circle me-2"></i>Maak Reservatie
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
