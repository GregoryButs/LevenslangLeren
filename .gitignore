# Root .gitignore - Prevent leak of secrets, credentials, databases and build artifacts

# Secrets & Credentials
google-credentials.json
*.json.user
.env
.env.*
appsettings.Production.json
appsettings.Local.json
*.pem
*.key
*.pfx

# Databases & Local Data
*.db
*.db-shm
*.db-wal
db_dump.txt

# Build & Dependency Directories
bin/
obj/
node_modules/
dist/
build/
.vs/
.idea/
.vscode/

# OS / Editor junk
.DS_Store
Thumbs.db
