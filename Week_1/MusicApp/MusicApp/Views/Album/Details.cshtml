@{
    ViewData["Title"] = "Details";
}
@model Album

<div class="container">
    <div class="row">
        <div class="col-md-8">
            <h1> @Model.Title</h1>
            <div>
                <div>
                    <div class="mb-2 d-flex align-items-start">
                        <div class="me-3">
                            <img src="@Model.ImageURL" class="img-fluid" style="max-width: 150px;" alt="@Model.Title" />
                        </div>
                        <div>
                            <p><strong>Title: </strong>@Model.Title</p>
                            <p><strong>Artist: </strong>@Model.Artist</p>
                            <p><strong>Rating: </strong>@Model.Rating</p>
                        </div>
                    </div>
                    <div class="mt-4">
                        <ul class="list-unstyled">
                            @foreach (var song in Model.Songs)
                            {
                                <li class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                    <span><i class="bi bi-music-note-list me-2"></i>@song.Title</span>
                                    <span>@TimeSpan.FromSeconds(song.Length).ToString(@"m\:ss")</span>
                                </li>
                            }
                        </ul>
                    </div>
                    <a asp-controller="Album" asp-action="Index">Keer terug naar alle albums</a>
                </div>
            </div>
        </div>
    </div>
</div>
