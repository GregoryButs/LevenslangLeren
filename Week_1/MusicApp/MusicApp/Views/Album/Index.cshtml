@{
    ViewData["Title"] = "Home Page";
}

@model List<Album>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

<div class="container">
    <div class="row">
        @foreach (var a in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <img src="@a.ImageURL" alt="@a.Title" style="width:50%; height:auto" class="card-img-top mx-auto d-block mt-3" />
                    <div class="card-body text-center">
                        <p class="card-text"> @a.Title</p>
                        <p class="card-text"> @a.Artist</p>
                        <p class="card-text">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Floor(a.Rating))
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else if (i - 0.5 <= a.Rating)
                                {
                                    <i class="bi bi-star-half text-warning"></i>
                                }
                                else
                                {
                                    <i class=""></i>
                                }
                            }
                        </p>
                        <a class="btn btn-primary "asp-controller="Album" asp-action="Details" asp-route-id="@a.Id">Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
