@model test3_model.Models.Viewmodels.EventViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4> @Html.DisplayFor(model => model.Titel)</h4>
    <hr />
    <dl class="row">
       
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Beschrijving)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Beschrijving)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StartDatumTijd)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StartDatumTijd)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EindDatumTijd)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EindDatumTijd)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BegeleiderNaam)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BegeleiderNaam)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BegeleiderFunctie)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.BegeleiderFunctie)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BegeleiderFotoUrl)
        </dt>
        <dd class = "col-sm-10">
            <img src=@Model.BegeleiderFotoUrl width="200px" />
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.LocatieNaam)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LocatieNaam)
        </dd>
    </dl>
</div>
<div>
    <form asp-action="Annuleer" asp-route-id="@Model.Id" class="d-inline-block">
    <button class="btn btn-danger">Annuleren</button>
</form>
    <a asp-action="Index">Toon Kalender</a>
</div>
