@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome @ViewBag.UserInfo</h1>
    @if (User.Identity.IsAuthenticated)
    {
        <p>You are authenticated with the following claims: @User.Identity.Name</p>
    }
    else
    {
        <p>You are not authenticated. Please log in to see your claims.</p>
    }
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
