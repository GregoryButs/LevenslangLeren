@model MVC_Bibliotheek.Models.GenreIndexViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Genres</h1>

<div class="mb-3">
    <button type="button" class="btn btn-primary" data-bs-toggle="collapse" data-bs-target="#createForm">
        <i class="bi bi-plus-circle"></i> Nieuw Genre Toevoegen
    </button>
</div>

<div class="collapse mb-4" id="createForm">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Nieuw Genre</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="NewGenre.Name" class="form-label"></label>
                    <input asp-for="NewGenre.Name" class="form-control" maxlength="100" />
                    <span asp-validation-for="NewGenre.Name" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-success">Opslaan</button>
                <button type="button" class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#createForm">Annuleren</button>
            </form>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Genre Lijst</h5>
    </div>
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>Genrenaam</th>
                    <th style="width: 150px;">Acties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Genres)
                {
                    <tr>
                        <td>
                            @if (Model.EditingGenreId == item.GenreId)
                            {
                                <form asp-action="Edit" method="post">
                                    <input type="hidden" asp-for="@item.GenreId" name="GenreId" />
                                    <div class="input-group input-group-sm">
                                        <input asp-for="@item.Name" class="form-control" name="Name" maxlength="100" />
                                        <button type="submit" class="btn btn-success">
                                            <i class="bi bi-check-circle"></i> Opslaan
                                        </button>
                                        <a asp-action="Index" class="btn btn-secondary">
                                            <i class="bi bi-x-circle"></i> Annuleren
                                        </a>
                                    </div>
                                    <span asp-validation-for="@item.Name" class="text-danger"></span>
                                </form>
                            }
                            else
                            {
                                @item.Name
                            }
                        </td>
                        <td>
                            @if (Model.EditingGenreId != item.GenreId)
                            {
                                <a asp-action="Edit" asp-route-id="@item.GenreId" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Wijzigen
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.GenreId" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Weet je zeker dat je dit genre wilt verwijderen?');">
                                        <i class="bi bi-trash"></i> Verwijderen
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}