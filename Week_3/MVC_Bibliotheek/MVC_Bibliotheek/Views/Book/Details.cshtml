@model MVC_Bibliotheek.Data.Entities.Book

@{
    ViewData["Title"] = "Details";
}

<h1>Boekdetails</h1>

<div class="card">
    <div class="card-body">
        <div class="row">
            @if (!string.IsNullOrEmpty(Model.CoverImagePath))
            {
                <div class="col-md-3 mb-3">
                    <img src="@Model.CoverImagePath" alt="Cover van @Model.Title" class="img-fluid img-thumbnail shadow" style="max-width: 100%; border-radius: 8px;" />
                </div>
                <div class="col-md-9">
                    <h4>@Model.Title</h4>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Author)
                        </dt>
                        <dd class="col-sm-9">
                            @($"{Model.Author.FirstName} {Model.Author.LastName}")
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Genre)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Genre.Name)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.ISBN13)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.ISBN13)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Publisher)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Publisher)
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.PublicationDate)
                        </dt>
                        <dd class="col-sm-9">
                            @Model.PublicationDate.ToString("dd/MM/yyyy")
                        </dd>
                        <dt class="col-sm-3">
                            @Html.DisplayNameFor(model => model.Pages)
                        </dt>
                        <dd class="col-sm-9">
                            @Html.DisplayFor(model => model.Pages)
                        </dd>
                    </dl>
                </div>
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info mb-3" role="alert">
                        <i class="bi bi-info-circle"></i> Dit boek heeft geen cover afbeelding.
                    </div>
                    <h4>@Model.Title</h4>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Author)
                        </dt>
                        <dd class="col-sm-10">
                            @($"{Model.Author.FirstName} {Model.Author.LastName}")
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Genre)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Genre.Name)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.ISBN13)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.ISBN13)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Publisher)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Publisher)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.PublicationDate)
                        </dt>
                        <dd class="col-sm-10">
                            @Model.PublicationDate.ToString("dd/MM/yyyy")
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Pages)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Pages)
                        </dd>
                    </dl>
                </div>
            }
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.BookId" class="btn btn-warning">
        <i class="bi bi-pencil"></i> Wijzigen
    </a>
    <form asp-action="Delete" asp-route-id="@Model?.BookId" method="post" style="display:inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger" onclick="return confirm('Weet je zeker dat je dit boek wilt verwijderen?');">
            <i class="bi bi-trash"></i> Verwijderen
        </button>
    </form>
    <a asp-action="BookList" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Terug naar lijst
    </a>
</div>
