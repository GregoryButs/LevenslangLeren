@model IEnumerable<MVC_Bibliotheek.Data.Entities.Book>

@{
    ViewData["Title"] = "BookList";
}

<h1>Boekencatalogus</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Voeg boek toe
    </a>
</p>

<div class="card">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">Cover</th>
                    <th>
                        @Html.DisplayNameFor(model => model.Title)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Author)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ISBN13)
                    </th>
                    <th style="width: 100px;">Acties</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(item.CoverImagePath))
                            {
                                <img src="@item.CoverImagePath" alt="Cover van @item.Title" class="img-thumbnail" style="max-width: 60px; max-height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 60px; height: 80px; font-size: 0.8rem;">
                                    <span>Geen<br />cover</span>
                                </div>
                            }
                        </td>
                        <td class="align-middle">
                            @Html.DisplayFor(modelItem => item.Title)
                        </td>
                        <td class="align-middle">
                            @($"{item.Author.FirstName} {item.Author.LastName}")
                        </td>
                        <td class="align-middle">
                            @Html.DisplayFor(modelItem => item.ISBN13)
                        </td>
                        <td class="align-middle">
                            <a asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
