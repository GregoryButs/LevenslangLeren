@model Movie_Store.Models.Movie

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        <dd class="col-sm-10">
            @Model.Price.ToString("c")
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AgeRestriction)
        </dt>
        <dd class="col-sm-10">
            @if (Model.AgeRestriction == null)
            {
                <text>None</text>
            }
            else
            {
                <text>@Model.AgeRestriction.Value.ToString()</text>
            }
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Genre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Genre.Name)
        </dd>

    </dl>
</div>

<!-- HIDE THESE BUTTONS IF USER HAS NOT THE RIGHT PERMISSION -->
<div>
    <a class="btn btn-primary" asp-controller="Movie" asp-action="Edit" asp-route-id="@Model.Id">Edit</a> 
    <form class="d-inline-block my-2" asp-controller="Movie" asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button class="btn btn-danger">Delete</button>
    </form>
</div>

<div>
    <form asp-controller="Cart" asp-action="AddToCart" class="form-inline my-3">
        <input type="hidden" name="movieId" value="@Model.Id"/>
        <div class="form-group">
            <label for="quantity">Quantity:</label>
            <input type="number" name="quantity" id="quantity" class="form-control ml-2 mr-4" />
            <button class="btn btn-success">Buy Now</button>
        </div>
    </form>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
