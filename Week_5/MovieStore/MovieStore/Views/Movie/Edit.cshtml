@using Movie_Store.Models;
@model Movie_Store.Models.ViewModels.UpdateMovieCommand

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>@Model.Title</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input type="text" asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AgeRestriction" class="control-label"></label>
                <div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="AgeRestriction" id="idNone" value="">
                        <label class="form-check-label" for="idNone">None</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="AgeRestriction" id="id12" value="@AgeRestriction.Plus12">
                        <label class="form-check-label" for="id12">12+</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="AgeRestriction" id="id16" value="@AgeRestriction.Plus16">
                        <label class="form-check-label" for="id16">16+</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" asp-for="AgeRestriction" id="id18" value="@AgeRestriction.Plus18">
                        <label class="form-check-label" for="id18">18+</label>
                    </div>
                </div>
                <span asp-validation-for="AgeRestriction" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SelectedGenreId" class="control-label"></label>
                <select asp-for="SelectedGenreId" asp-items="@(new SelectList(Model.Genres, nameof(Genre.Id), nameof(Genre.Name)))" class="form-control"></select>
                <span asp-validation-for="SelectedGenreId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
